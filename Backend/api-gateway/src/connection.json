{
  "name": "FabricNetwork",
  "version": "1.0.0",
  "client": {
    "organization": "Pesachain",
    "connection": {
      "timeout": {
        "peer": { "endorser": "300" }
      }
    }
  },

  "organizations": {
    "Pesachain": {
      "mspId": "PesachainMSP",
      "peers": [
        "peer0.pesachain.com",
        "peer1.pesachain.com"
      ],
      "certificateAuthorities": [
        "ca.pesachain.com"
      ]
    },
    "Org2": {
      "mspId": "Org2MSP",
      "peers": [
        "peer0.org2.example.com",
        "peer1.org2.example.com"
      ],
      "certificateAuthorities": [
        "ca.org2.example.com"
      ]
    }
  },

  "peers": {
    "peer0.pesachain.com": {
      "url": "grpcs://peer0.pesachain.com:7051",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.pesachain.com",
        "grpc.keepalive_time_ms": 600000
      },
      "tlsCACerts": {
        "path": "/Vault/vault-secrets/client/tlsca/pesachainTlsca.pem"
      }
    },
    "peer1.pesachain.com": {
      "url": "grpcs://peer1.pesachain.com:8051",
      "grpcOptions": {
        "ssl-target-name-override": "peer1.pesachain.com",
        "grpc.keepalive_time_ms": 600000
      },
      "tlsCACerts": {
        "path": "/Vault/vault-secrets/client/tlsca/pesachainTlsca.pem"
      }
    },
    "peer0.org2.example.com": {
      "url": "grpcs://peer0.org2.example.com:9051",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.org2.example.com",
        "grpc.keepalive_time_ms": 600000
      },
      "tlsCACerts": {
        "path": "/Vault/vault-secrets/client/tlsca/org2Tlsca.pem"
      }
    },
    "peer1.org2.example.com": {
      "url": "grpcs://peer1.org2.example.com:10051",
      "grpcOptions": {
        "ssl-target-name-override": "peer1.org2.example.com",
        "grpc.keepalive_time_ms": 600000
      },
      "tlsCACerts": {
        "path": "/Vault/vault-secrets/client/tlsca/org2Tlsca.pem"
      }
    }
  },

  "orderers": {
    "orderer.com": {
      "url": "grpcs://orderer.com:7050",
      "grpcOptions": {
        "ssl-target-name-override": "orderer.com"
      },
      "tlsCACerts": {
        "path": "/Vault/vault-secrets/client/tls/ca1.crt"
      }
    },
    "orderer2.com": {
      "url": "grpcs://orderer2.com:8050",
      "grpcOptions": {
        "ssl-target-name-override": "orderer2.com"
      },
      "tlsCACerts": {
        "path": "/Vault/vault-secrets/client/tls/ca2.crt"
      }
    },
    "orderer3.com": {
      "url": "grpcs://orderer3.com:9050",
      "grpcOptions": {
        "ssl-target-name-override": "orderer3.com"
      },
      "tlsCACerts": {
        "path": "/Vault/vault-secrets/client/tls/ca3.crt"
      }
    }
  },

  "certificateAuthorities": {
    "ca.pesachain.com": {
      "url": "https://ca.pesachain.com:7054",
      "httpOptions": { "verify": false },
      "tlsCACerts": {
        "path": "/Vault/vault-secrets/client/tlsca/pesachainTlsca.pem"
      }
    },
    "ca.org2.example.com": {
      "url": "https://ca.org2.example.com:8054",
      "httpOptions": { "verify": false },
      "tlsCACerts": {
        "path": "/Vault/vault-secrets/client/tlsca/org2Tlsca.pem"
      }
    }
  },

  "channels": {
    "payment-channel": {
      "orderers": [
        "orderer.com",
        "orderer2.com",
        "orderer3.com"
      ],
      "peers": {
        "peer0.pesachain.com": {},
        "peer1.pesachain.com": {},
        "peer0.org2.example.com": {},
        "peer1.org2.example.com": {}
      }
    },
    "paymentsOrchestrator-channel": {
      "orderers": [
        "orderer.com",
        "orderer2.com",
        "orderer3.com"
      ],
      "peers": {
        "peer0.pesachain.com": {},
        "peer1.pesachain.com": {},
        "peer0.org2.example.com": {},
        "peer1.org2.example.com": {}
      },
      "contracts": {
        "paymentsControllerCC": {
          "version": "1.0.3",
          "language": "golang"
        }
      }
    }
  }
}
